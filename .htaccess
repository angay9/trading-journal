# /trading/.htaccess

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /trading/

    # If the request is already pointing inside dist, leave it alone
    RewriteCond %{REQUEST_URI} !^/trading/dist/

    # Don't rewrite real files/dirs in root (like .htaccess itself)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Send everything to dist/index.html
    RewriteRule ^ dist/index.html [L]
</IfModule>